<%- include('partials/head', { title: title }) %>
<%- include('partials/header') %>

<section class="mb-8 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Status Server</h1>
    <p class="mt-1 text-sm text-slate-600">
      Halaman ini membaca <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">/api/health</code> setiap 10 detik.
    </p>
  </div>
  <button id="btn-refresh" type="button" class="btn-primary">Refresh</button>
</section>

<section class="card">
  <div class="mb-5 flex items-center gap-3">
    <span id="st-badge" class="rounded-full bg-slate-100 px-3 py-1 text-sm font-semibold text-slate-600">Memeriksa...</span>
  </div>

  <dl class="grid gap-x-8 gap-y-4 text-sm sm:grid-cols-2">
    <div><dt class="text-xs font-medium uppercase text-slate-500">Aplikasi</dt><dd id="st-app" class="mt-1 font-semibold text-slate-900">-</dd></div>
    <div><dt class="text-xs font-medium uppercase text-slate-500">Versi Node.js</dt><dd id="st-node" class="mt-1 font-semibold text-slate-900">-</dd></div>
    <div><dt class="text-xs font-medium uppercase text-slate-500">Environment</dt><dd id="st-env" class="mt-1 font-semibold text-slate-900">-</dd></div>
    <div><dt class="text-xs font-medium uppercase text-slate-500">Uptime Aplikasi</dt><dd id="st-uptime" class="mt-1 font-semibold text-slate-900">-</dd></div>
    <div><dt class="text-xs font-medium uppercase text-slate-500">Database</dt><dd id="st-db" class="mt-1 font-semibold text-slate-900">-</dd></div>
    <div><dt class="text-xs font-medium uppercase text-slate-500">Waktu Server DB</dt><dd id="st-time" class="mt-1 font-semibold text-slate-900">-</dd></div>
    <div><dt class="text-xs font-medium uppercase text-slate-500">Host yang diakses</dt><dd id="st-host" class="mt-1 font-semibold text-slate-900">-</dd></div>
    <div><dt class="text-xs font-medium uppercase text-slate-500">IP Klien</dt><dd id="st-client" class="mt-1 font-semibold text-slate-900">-</dd></div>
    <div class="sm:col-span-2"><dt class="text-xs font-medium uppercase text-slate-500">Lewat Nginx (reverse proxy)?</dt><dd id="st-proxy" class="mt-1 font-semibold text-slate-900">-</dd></div>
  </dl>
</section>

<script src="/js/status.js" defer></script>
<%- include('partials/footer') %>
