# Salin:  cp .env.example .env   lalu isi DB_PASSWORD
# File .env jangan di-commit (sudah ada di .gitignore)

# 8-64 karakter: huruf, angka, dan _ . @ % + = -
DB_PASSWORD=

DB_NAME=praktikum_db
DB_USER=praktikum_user
APP_NAME=Praktikum Minggu 3 (Docker)

# Port yang dibuka ke host. Jika port 80 masih dipakai Nginx lama, ganti mis. 8080
HTTP_PORT=80
