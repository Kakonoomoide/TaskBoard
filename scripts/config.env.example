# =====================================================================
#  Konfigurasi bersama semua script.
#  Salin:  cp config.env.example config.env   lalu isi DB_PASSWORD.
#  File config.env TIDAK boleh di-commit (sudah ada di .gitignore).
# =====================================================================

# ---- Wajib diisi ----
# 8-64 karakter: huruf, angka, dan _ . @ % + = -
DB_PASSWORD=

# ---- Database (boleh diganti) ----
DB_NAME=praktikum_db
DB_USER=praktikum_user
DB_HOST=127.0.0.1
DB_PORT=5432

# ---- Aplikasi ----
APP_DISPLAY_NAME="Praktikum Minggu 1"
PM2_APP_NAME=praktikum-app     # harus sama dengan name di apps/ecosystem.config.js
APP_HOST=127.0.0.1
APP_PORT=3000
NODE_VERSION=26

# ---- Nginx ----
NGINX_SITE=praktikum
NGINX_CONF_FILE=praktikum.conf

# ---- Deploy ----
# Default: branch git yang sedang aktif. Isi jika ingin dipaksa, misalnya main
#GIT_BRANCH=main
HEALTH_TIMEOUT=30              # detik menunggu aplikasi sehat setelah deploy

# ---- Ambang batas health check ----
MEM_WARN=80
MEM_CRIT=90
DISK_WARN=80
DISK_CRIT=90
LOAD_WARN=1.0                  # beban rata-rata per core
LOAD_CRIT=2.0
